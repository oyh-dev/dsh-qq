{
  "name": "@dsh-local/dsh-qq",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "QQ bridge for DeepSeek Harness: OneBot messaging, media understanding, Qzone, and an in-page control panel",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "FEATURES.md"
  ],
  "devDependencies": {
    "ws": "^8.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
